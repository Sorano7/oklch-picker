{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "oklch",
  "version": "0.1.0",
  "identifier": "com.kinoa.oklch",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OKLCH",
        "width": 300,
        "height": 360,
        "minWidth": 200,
        "minHeight": 250,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": true,
        "transparent": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
